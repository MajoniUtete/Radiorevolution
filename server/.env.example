# Radio Revolution Push Notification Server
# Copy this file to .env and fill in your values

# ── VAPID Keys (generate with: npm run generate-vapid) ──────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:hello@radiorevolution.co.zw

# ── Server Config ────────────────────────────────────────────────────────────
PORT=3001
HOST_SECRET_KEY=change_this_to_a_strong_secret_key

# ── CORS: Your PWA domain (comma-separated) ──────────────────────────────────
ALLOWED_ORIGINS=https://radiorevolution.co.zw,http://localhost:5500

# ── Stream Status URL (ICEcast/SHOUTcast) ────────────────────────────────────
# ICEcast:   https://your-stream.com/status-json.xsl
# SHOUTcast: https://your-stream.com/stats?json=1
STREAM_STATUS_URL=https://your-stream-url.com/status-json.xsl
